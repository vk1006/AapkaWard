# =============================================================================
# PRODUCTION — Vercel or AWS ECS
#
# Do NOT commit real values. Set in:
#   - Vercel: Project → Settings → Environment Variables
#   - AWS ECS: Secrets Manager (sensitive) + task definition (non-sensitive)
#
# See docs/SETUP.md for local vs prod guide and deploy checklists.
# =============================================================================

# --- Database ---
DATABASE_URL=

# --- Auth (real Firebase phone OTP) ---
OTP_ADAPTER=firebase
NEXT_PUBLIC_OTP_ADAPTER=firebase
ADMIN_PHONES=

# --- Firebase server (ECS: Secrets Manager only) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# --- Firebase client (Vercel: set in dashboard; ECS: baked into Docker image at build) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- File storage ---
FILE_STORE_ADAPTER=
AWS_REGION=
AWS_S3_BUCKET=

# Vercel: use IAM user keys below.
# AWS ECS: omit keys — task IAM role grants S3 access.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- App ---
MODERATION_ADAPTER=blocklist
NODE_ENV=production

# --- Website feedback email (Resend) ---
# Set all three in Vercel Environment Variables. The sender domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Aapka Ward 20 <noreply@aapkaward.in>"
WEBSITE_FEEDBACK_TO=
