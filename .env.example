# =============================================================================
# LOCAL DEVELOPMENT — copy to .env.local
#   cp .env.example .env.local
#
# Production values: see .env.production.example and docs/SETUP.md
# =============================================================================

# --- Database (pick one) ---
# Local Docker Postgres (docker-compose up -d postgres):
# DATABASE_URL=postgresql://ward:ward@localhost:5432/ward_campaign
#
# Neon (neon link && neon env pull):
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

# --- Auth (local: mock OTP, no SMS) ---
OTP_ADAPTER=mock
NEXT_PUBLIC_OTP_ADAPTER=mock
ADMIN_PHONES=+919999999999

# --- Firebase (only when OTP_ADAPTER=firebase) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- File storage (local: ./uploads) ---
FILE_STORE_ADAPTER=local
UPLOAD_DIR=./uploads

# --- AWS S3 (when FILE_STORE_ADAPTER=s3) ---
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=

# --- Cloudflare R2 (when FILE_STORE_ADAPTER=r2) ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
# Optional: public custom domain or r2.dev URL (e.g. https://pub-xxx.r2.dev or https://media.aapkaward.in)
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_ENDPOINT=

# --- App ---
MODERATION_ADAPTER=blocklist
NODE_ENV=development

# --- Website feedback email (Resend) ---
# Keep these server-only; do not prefix them with NEXT_PUBLIC_.
RESEND_API_KEY=
EMAIL_FROM="Aapka Ward 20 <noreply@aapkaward.in>"
WEBSITE_FEEDBACK_TO=

# --- Optional: benchmark against a deployed URL ---
BENCH_PROD_URL=
